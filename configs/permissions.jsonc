{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask"
  },
  "bash": {
    "*": "ask",
    "ls": "allow",
    "ls *": "allow",
    "pwd": "allow",
    "git status": "allow",
    "git diff": "allow"
  }
}
